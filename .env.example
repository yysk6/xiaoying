# Offline Mock and pytest need no variables or credentials.
# The application does not auto-load .env files; set variables in your shell.
# Structured CLI (python -m content_planner run --backend deepseek):
DEEPSEEK_API_KEY=replace-with-your-own-key
# Optional values below are fixed to the official service/model by the adapter.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
# scripts/interactive_planner.py and evaluate_core20 --live --key-stdin
# can read a hidden terminal prompt instead; no environment variable is required.
# Never put real credentials in this file or commit a local .env.
