{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TaskResult v1.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "request_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "backend": {
      "enum": [
        "mock",
        "deepseek"
      ]
    },
    "model": {
      "anyOf": [
        {
          "enum": [
            "mock",
            "deepseek-v4-pro"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": [
        "needs_input",
        "running",
        "completed",
        "incomplete"
      ]
    },
    "reason": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        {
          "type": "null"
        }
      ]
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "missing_fields": {
      "type": "array",
      "items": {
        "enum": [
          "request_id",
          "topic",
          "budget_units",
          "deadline_at"
        ]
      },
      "minItems": 0,
      "maxItems": 4,
      "uniqueItems": true
    },
    "task_plan": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/TaskPlanStep"
      },
      "minItems": 0,
      "maxItems": 4
    },
    "execution_steps": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/ExecutionStep"
      },
      "minItems": 0
    },
    "tool_results": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/ToolResult"
      },
      "minItems": 0
    },
    "current_revision": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        {
          "type": "null"
        }
      ]
    },
    "candidate": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/Candidate"
        },
        {
          "type": "null"
        }
      ]
    },
    "total_units": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "saved_plan": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/SavedPlan"
        },
        {
          "type": "null"
        }
      ]
    },
    "usage": {
      "type": "object",
      "properties": {
        "model_requests": {
          "type": "integer",
          "minimum": 0
        },
        "action_calls": {
          "type": "integer",
          "minimum": 0
        },
        "input_tokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "output_tokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "api_cost_usd": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "model_requests",
        "action_calls",
        "input_tokens",
        "output_tokens",
        "api_cost_usd"
      ],
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "properties": {
        "max_model_requests": {
          "const": 32
        },
        "max_action_calls": {
          "const": 24
        },
        "max_revisions": {
          "const": 4
        },
        "remaining_model_requests": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32
        },
        "remaining_action_calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 24
        }
      },
      "required": [
        "max_model_requests",
        "max_action_calls",
        "max_revisions",
        "remaining_model_requests",
        "remaining_action_calls"
      ],
      "additionalProperties": false
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "trace_path": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        {
          "type": "null"
        }
      ]
    },
    "manifest": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/Manifest"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "backend",
    "model",
    "status",
    "reason",
    "message",
    "missing_fields",
    "task_plan",
    "execution_steps",
    "tool_results",
    "current_revision",
    "candidate",
    "total_units",
    "saved_plan",
    "usage",
    "limits",
    "warnings",
    "trace_path",
    "manifest"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed"
          }
        }
      },
      "then": {
        "properties": {
          "saved_plan": {
            "$ref": "common.schema.json#/$defs/SavedPlan"
          },
          "task_plan": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/TaskPlanStep"
            },
            "minItems": 4,
            "maxItems": 4
          },
          "total_units": {
            "type": "integer",
            "minimum": 0
          },
          "reason": {
            "type": "null"
          },
          "missing_fields": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "saved_plan": {
            "type": "null"
          },
          "task_plan": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
