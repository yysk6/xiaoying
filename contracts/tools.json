[
  {
    "type": "function",
    "function": {
      "name": "search_materials",
      "description": "检索合成素材；空数组是成功结果，可由模型选择改写查询。",
      "parameters": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "top_k": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "可公开的一句话动作依据，不包含内部思维过程"
          }
        },
        "required": [
          "query",
          "top_k",
          "rationale"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "revise_plan",
      "description": "建立或修订候选；仅改变素材、创意简述或制作档位，不改变用户预算/截止时间。",
      "parameters": {
        "type": "object",
        "properties": {
          "material_id": {
            "type": "string",
            "pattern": "^M[0-9]{2}$"
          },
          "creative_brief": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "production_mode": {
            "enum": [
              "basic",
              "premium"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "可公开的一句话动作依据，不包含内部思维过程"
          }
        },
        "required": [
          "material_id",
          "creative_brief",
          "production_mode",
          "rationale"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "generate_script",
      "description": "为当前候选生成或复用有来源的脚本草稿；内部一次模型调用。",
      "parameters": {
        "type": "object",
        "properties": {
          "plan_revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "可公开的一句话动作依据，不包含内部思维过程"
          }
        },
        "required": [
          "plan_revision",
          "rationale"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "estimate_cost",
      "description": "计算当前候选的分项费用、工期及硬约束结果；不自动选择替代档位。",
      "parameters": {
        "type": "object",
        "properties": {
          "plan_revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "可公开的一句话动作依据，不包含内部思维过程"
          }
        },
        "required": [
          "plan_revision",
          "rationale"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "save_plan",
      "description": "保存当前已估算且满足约束的方案；事务提交成功后才完成任务。",
      "parameters": {
        "type": "object",
        "properties": {
          "plan_revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "estimate_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "可公开的一句话动作依据，不包含内部思维过程"
          }
        },
        "required": [
          "plan_revision",
          "estimate_id",
          "rationale"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "stop_task",
      "description": "根据已观察事实说明未完成原因并结束；不能虚报保存或修改硬约束。",
      "parameters": {
        "type": "object",
        "properties": {
          "reason": {
            "enum": [
              "no_material",
              "constraints_unsatisfied",
              "tool_failure"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "可公开的一句话动作依据，不包含内部思维过程"
          }
        },
        "required": [
          "reason",
          "message",
          "rationale"
        ],
        "additionalProperties": false
      }
    }
  }
]
